
import os
import sys
import time
import tempfile

import requests
from dotenv import load_dotenv
from xai_sdk import Client

load_dotenv()

API_KEY = os.getenv("XAI_API_KEY")
if not API_KEY:
    raise RuntimeError("XAI_API_KEY not set — check your .env file")

MODEL = "grok-2-image"
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
JPEG_SIGNATURE = b"\xff\xd8\xff"

client = Client(api_key=API_KEY)


def is_valid_image(filepath: str) -> bool:
    """Check the file's magic bytes for PNG or JPEG."""
    with open(filepath, "rb") as f:
        header = f.read(8)
    return header.startswith(PNG_SIGNATURE) or header.startswith(JPEG_SIGNATURE)


def download(url: str, filepath: str) -> None:
    resp = requests.get(url, timeout=30)
    resp.raise_for_status()
    with open(filepath, "wb") as f:
        f.write(resp.content)


def test_batch_count(tmpdir: str):
    """Test 1: batch returns exactly n images."""
    print("=" * 60)
    print("TEST 1: Batch returns correct count (n=3)")
    print("=" * 60)
    n = 3
    responses = client.image.sample_batch(
        model=MODEL,
        prompt="A minimalist geometric mountain landscape at sunset",
        n=n,
        image_format="url",
    )
    count = len(responses)
    print(f"Requested: {n}, received: {count}")
    assert count == n, f"Expected {n} images, got {count}"
    print("PASSED\n")
    return responses


def test_batch_downloads(responses, tmpdir: str):
    """Test 2: every returned URL downloads to a valid image file."""
    print("=" * 60)
    print("TEST 2: All batch images download and are valid")
    print("=" * 60)
    files = []
    for i, resp in enumerate(responses):
        filepath = os.path.join(tmpdir, f"batch_{i}.png")
        download(resp.url, filepath)
        size = os.path.getsize(filepath)
        valid = is_valid_image(filepath)
        print(f"  batch_{i}.png — {size:,} bytes — valid image: {valid}")
        assert size > 0, f"Image {i} is empty"
        assert valid, f"Image {i} is not a valid PNG/JPEG"
        files.append(filepath)
    print("PASSED\n")
    return files


def test_batch_images_distinct(files):
    """Test 3: batch images are not identical copies."""
    print("=" * 60)
    print("TEST 3: Batch images are distinct")
    print("=" * 60)
    contents = set()
    for f in files:
        with open(f, "rb") as fh:
            contents.add(fh.read())
    print(f"Files: {len(files)}, unique: {len(contents)}")
    assert len(contents) == len(files), "Duplicate images found in batch"
    print("PASSED\n")


def test_batch_base64(tmpdir: str):
    """Test 4: batch works with base64 format (no download step)."""
    print("=" * 60)
    print("TEST 4: Batch with base64 format (n=2)")
    print("=" * 60)
    import base64

    responses = client.image.sample_batch(
        model=MODEL,
        prompt="Abstract watercolor texture, blue and gold",
        n=2,
        image_format="base64",
    )
    assert len(responses) == 2, f"Expected 2, got {len(responses)}"
    for i, resp in enumerate(responses):
        filepath = os.path.join(tmpdir, f"b64_{i}.png")
        with open(filepath, "wb") as f:
            f.write(base64.b64decode(resp.image))
        assert is_valid_image(filepath), f"base64 image {i} invalid"
        print(f"  b64_{i}.png — {os.path.getsize(filepath):,} bytes — OK")
    print("PASSED\n")


def test_batch_revised_prompts(responses):
    """Test 5: each batch image carries a revised prompt."""
    print("=" * 60)
    print("TEST 5: Revised prompts present")
    print("=" * 60)
    for i, resp in enumerate(responses):
        prompt = getattr(resp, "prompt", None)
        print(f"  Image {i}: {prompt[:80] if prompt else 'MISSING'}...")
        assert prompt, f"Image {i} missing revised prompt"
    print("PASSED\n")


def test_batch_latency():
    """Test 6: measure batch generation time."""
    print("=" * 60)
    print("TEST 6: Batch latency (n=2)")
    print("=" * 60)
    start = time.time()
    client.image.sample_batch(
        model=MODEL,
        prompt="A single red apple on a white table",
        n=2,
        image_format="url",
    )
    elapsed = time.time() - start
    print(f"Batch of 2 completed in {elapsed:.2f}s ({elapsed/2:.2f}s per image)")
    print("PASSED\n")


