import os
import requests
import pandas as pd
from dotenv import load_dotenv

load_dotenv()

MANAGEMENT_API_KEY = os.getenv("XAI_MANAGEMENT_API_KEY")
if not MANAGEMENT_API_KEY:
    raise ValueError("Error: 'XAI_MANAGEMENT_API_KEY' not found in environment.")

# xAI Management API Base URL (No /v1 prefix)
BASE_URL = "https://management-api.x.ai"
HEADERS = {
    "Authorization": f"Bearer {MANAGEMENT_API_KEY}",
    "Content-Type": "application/json"
}

def fetch_audit_logs() -> pd.DataFrame:
    """Fetch admin and user activity logs from xAI Management API."""
    url = f"{BASE_URL}/audit-logs"
    params = {"pageSize": 100}
    
    try:
        response = requests.get(url, headers=HEADERS, params=params)
        response.raise_for_status()
        data = response.json()
        
        events = data.get("auditEvents", data.get("events", []))
        if not events:
            print("No audit events found.")
            return pd.DataFrame()
            
        records = []
        for event in events:
            user_id = event.get("userId") or event.get("actor", {}).get("id", "System/API")
            event_type = event.get("eventType") or event.get("description", "Activity")
            timestamp = event.get("eventTime") or event.get("created_at")
            
            records.append({
                "User / Actor ID": user_id,
                "Event": event_type,
                "Timestamp": timestamp
            })
            
        df = pd.DataFrame(records)
        df["Timestamp"] = pd.to_datetime(df["Timestamp"]).dt.strftime("%Y-%m-%d %H:%M:%S")
        return df

    except requests.exceptions.HTTPError as e:
        print(f"[HTTP Error {e.response.status_code}]: {e.response.text}")
        return pd.DataFrame()

if __name__ == "__main__":
    df = fetch_audit_logs()
    if not df.empty:
        print(df.to_string(index=False))
