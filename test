"""
grok_file_upload.py — upload and manage files via the xAI Files API
Requires: xai-sdk >= 1.4.0  (pip install --upgrade xai-sdk)
Run: python grok_file_upload.py <path-to-file>
"""

import os
import sys

from dotenv import load_dotenv
from xai_sdk import Client
from xai_sdk.chat import user, file

load_dotenv()

API_KEY = os.getenv("XAI_API_KEY")
if not API_KEY:
    raise RuntimeError("XAI_API_KEY not set — check your .env file")

client = Client(api_key=API_KEY)


def upload_file(filepath: str):
    """Upload a file from disk and return the file object."""
    uploaded = client.files.upload(filepath)
    print(f"File ID:    {uploaded.id}")
    print(f"Filename:   {uploaded.filename}")
    print(f"Size:       {uploaded.size:,} bytes")
    print(f"Created at: {uploaded.created_at}")
    return uploaded


def upload_from_bytes(content: bytes, filename: str):
    """Upload raw bytes directly — handy for generated content in pipelines."""
    uploaded = client.files.upload(content, filename=filename)
    print(f"Uploaded {filename} -> {uploaded.id}")
    return uploaded


def upload_with_progress(filepath: str):
    """Upload a large file with a progress bar (pip install tqdm)."""
    from tqdm import tqdm

    total = os.path.getsize(filepath)
    with tqdm(total=total, unit="B", unit_scale=True, desc="Uploading") as pbar:
        uploaded = client.files.upload(filepath, on_progress=pbar.update)
    print(f"Done: {uploaded.filename} -> {uploaded.id}")
    return uploaded


def list_files(limit: int = 10):
    """List uploaded files, newest first."""
    response = client.files.list(limit=limit, order="desc", sort_by="created_at")
    for f in response.files:
        print(f"  {f.id}  {f.filename}  ({f.size:,} bytes)")
    return response


def chat_with_file(file_id: str, question: str) -> str:
    """Attach an uploaded file to a chat and query it."""
    chat = client.chat.create(model="grok-4")
    chat.append(user(question, file(file_id)))
    response = chat.sample()
    return response.content


def delete_file(file_id: str):
    client.files.delete(file_id)
    print(f"Deleted {file_id}")


if __name__ == "__main__":
    if len(sys.argv) > 1:
        # Upload a real file from the command line
        filepath = sys.argv[1]
        uploaded = upload_file(filepath)
    else:
        # Demo: upload generated content
        content = b"Project: SAP-to-Azure replication\nStatus: In progress\nOwner: Data Engineering"
        uploaded = upload_from_bytes(content, "status.txt")

    print("\nYour files:")
    list_files()

    print("\nAsking Grok about the file...")
    answer = chat_with_file(uploaded.id, "Summarize this document in one sentence.")
    print(f"Answer: {answer}")

    # Clean up (comment out to keep the file)
    delete_file(uploaded.id)
