Install-Module -Name Az -AllowClobber -Scope CurrentUser
Connect-AzAccount

# Define the prefix to search for
$groupPrefix = "Grok_"

# Fetch groups starting with the prefix
$groups = Get-AzADGroup -DisplayNameStartsWith $groupPrefix

if (-not $groups) {
    Write-Host "No groups found starting with '$groupPrefix'" -ForegroundColor Yellow
    return
}

# Array list to store report items
$report = [System.Collections.Generic.List[PSCustomObject]]::new()

foreach ($group in $groups) {
    Write-Host "Processing group: $($group.DisplayName)" -ForegroundColor Cyan

    # Fetch members of the group
    $members = Get-AzADGroupMember -GroupObjectId $group.Id

    foreach ($member in $members) {
        # Filter strictly for 'User' objects to ignore nested groups or devices
        if ($member.Type -eq 'User' -or $member.UserPrincipalName) {
            $report.Add([PSCustomObject]@{
                GroupName         = $group.DisplayName
                GroupId           = $group.Id
                UserDisplayName   = $member.DisplayName
                UserPrincipalName = $member.UserPrincipalName
                UserEmail         = $member.Mail
            })
        }
    }
}

# Output the results in console format
$report | Format-Table -AutoSize

