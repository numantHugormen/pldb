import os
import requests
import pandas as pd
from datetime import datetime
from dotenv import load_dotenv

# ==========================================
# Load Environment Variables from .env
# ==========================================
load_dotenv()

MANAGEMENT_API_KEY = os.getenv("XAI_MANAGEMENT_API_KEY")

if not MANAGEMENT_API_KEY:
    raise ValueError("Error: 'XAI_MANAGEMENT_API_KEY' not found in .env file or environment.")

BASE_URL = "https://management-api.x.ai/v1"

HEADERS = {
    "Authorization": f"Bearer {MANAGEMENT_API_KEY}",
    "Content-Type": "application/json"
}

def get_team_members(session: requests.Session) -> dict:
    """Fetch user mapping (user_id -> user_name/email) across the team."""
    url = f"{BASE_URL}/users"
    members = {}
    
    try:
        response = session.get(url, headers=HEADERS)
        response.raise_for_status()
        data = response.json()
        
        user_list = data.get("users", data.get("data", []))
        for user in user_list:
            user_id = user.get("id") or user.get("user_id")
            name = user.get("name") or user.get("email") or f"User_{user_id}"
            members[user_id] = name
            
    except requests.exceptions.HTTPError as e:
        print(f"[Warning] Could not fetch user directory: {e}")
        
    return members

def fetch_usage_report() -> pd.DataFrame:
    """Query usage logs and aggregate activity metrics per user."""
    session = requests.Session()
    
    # 1. Fetch user directory map
    user_map = get_team_members(session)
    
    # 2. Fetch team usage records
    usage_url = f"{BASE_URL}/usage"
    params = {"limit": 100}
    
    user_stats = {}
    
    try:
        response = session.get(usage_url, headers=HEADERS, params=params)
        response.raise_for_status()
        records = response.json().get("usage", response.json().get("data", []))
        
        for record in records:
            user_id = record.get("user_id", "unknown_user")
            user_name = user_map.get(user_id, record.get("user_name", user_id))
            
            timestamp = record.get("created_at") or record.get("timestamp")
            messages = record.get("message_count") or record.get("requests", 1)
            
            if user_name not in user_stats:
                user_stats[user_name] = {
                    "User Name": user_name,
                    "Last Activity": timestamp,
                    "Total Messages": 0
                }
                
            user_stats[user_name]["Total Messages"] += messages
            
            if timestamp and (user_stats[user_name]["Last Activity"] is None or timestamp > user_stats[user_name]["Last Activity"]):
                user_stats[user_name]["Last Activity"] = timestamp
                
    except requests.exceptions.RequestException as e:
        print(f"[Error] Failed to fetch usage metrics: {e}")
        return pd.DataFrame()

    # 3. Format and clean output
    df = pd.DataFrame(list(user_stats.values()))
    
    if not df.empty and "Last Activity" in df.columns:
        df["Last Activity"] = pd.to_datetime(df["Last Activity"]).dt.strftime("%Y-%m-%d %H:%M:%S")
        df = df.sort_values(by="Total Messages", ascending=False).reset_index(drop=True)
        
    return df

# ==========================================
# Execution
# ==========================================
if __name__ == "__main__":
    print("Generating Grok Enterprise Usage Report...")
    report_df = fetch_usage_report()
    
    if not report_df.empty:
        print("\n--- Usage Report ---")
        print(report_df.to_string(index=False))
        
        report_df.to_csv("grok_enterprise_usage_report.csv", index=False)
        print("\nReport successfully saved to 'grok_enterprise_usage_report.csv'")
    else:
        print("No usage data returned.")
