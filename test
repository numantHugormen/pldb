import os
import requests
import pandas as pd
from datetime import datetime
from dotenv import load_dotenv

# ==========================================
# Load Environment Variables
# ==========================================
load_dotenv()

MANAGEMENT_API_KEY = os.getenv("XAI_MANAGEMENT_API_KEY")

if not MANAGEMENT_API_KEY:
    raise ValueError("Error: 'XAI_MANAGEMENT_API_KEY' not found in environment or .env file.")

BASE_URL = "https://management-api.x.ai/v1"

HEADERS = {
    "Authorization": f"Bearer {MANAGEMENT_API_KEY}",
    "Content-Type": "application/json"
}

def fetch_usage_report() -> pd.DataFrame:
    """Fetch usage activity logs from xAI Management API and aggregate metrics."""
    session = requests.Session()
    
    # Query team usage endpoint
    usage_url = f"{BASE_URL}/usage"
    params = {"limit": 100}
    
    user_stats = {}
    
    try:
        response = session.get(usage_url, headers=HEADERS, params=params)
        response.raise_for_status()
        data = response.json()
        
        # Parse usage entries
        records = data.get("usage") or data.get("data") or []
        
        for record in records:
            # Identify user or key ID
            user_identifier = (
                record.get("user_name") 
                or record.get("user_id") 
                or record.get("api_key_id") 
                or "Unknown User/Key"
            )
            
            timestamp = record.get("created_at") or record.get("timestamp")
            messages = record.get("message_count") or record.get("requests", 1)
            
            if user_identifier not in user_stats:
                user_stats[user_identifier] = {
                    "User Name / ID": user_identifier,
                    "Last Activity": timestamp,
                    "Total Messages": 0
                }
                
            user_stats[user_identifier]["Total Messages"] += messages
            
            # Keep the most recent timestamp
            if timestamp and (
                user_stats[user_identifier]["Last Activity"] is None 
                or timestamp > user_stats[user_identifier]["Last Activity"]
            ):
                user_stats[user_identifier]["Last Activity"] = timestamp
                
    except requests.exceptions.HTTPError as e:
        print(f"[Error] Management API request failed ({e.response.status_code}): {e.response.text}")
        return pd.DataFrame()
    except requests.exceptions.RequestException as e:
        print(f"[Error] Request error: {e}")
        return pd.DataFrame()

    # Format into DataFrame
    df = pd.DataFrame(list(user_stats.values()))
    
    if not df.empty and "Last Activity" in df.columns:
        df["Last Activity"] = pd.to_datetime(df["Last Activity"]).dt.strftime("%Y-%m-%d %H:%M:%S")
        df = df.sort_values(by="Total Messages", ascending=False).reset_index(drop=True)
        
    return df

# ==========================================
# Execution
# ==========================================
if __name__ == "__main__":
    print("Generating Grok Enterprise Usage Report...")
    report_df = fetch_usage_report()
    
    if not report_df.empty:
        print("\n--- Usage Report ---")
        print(report_df.to_string(index=False))
        
        report_df.to_csv("grok_enterprise_usage_report.csv", index=False)
        print("\nReport successfully saved to 'grok_enterprise_usage_report.csv'")
    else:
        print("No usage data returned or API request was unfulfilled.")
