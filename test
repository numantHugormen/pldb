"""
grok_image_gen.py — generate images via the xAI Grok Image API
Run: python grok_image_gen.py
"""

import os
import base64

import requests
from dotenv import load_dotenv
from xai_sdk import Client

load_dotenv()

API_KEY = os.getenv("XAI_API_KEY")
if not API_KEY:
    raise RuntimeError("XAI_API_KEY not set — check your .env file")

client = Client(api_key=API_KEY)


def generate_image(prompt: str, output_file: str = "output.png") -> str:
    """Generate a single image and save it to disk."""
    response = client.image.sample(
        model="grok-2-image",
        prompt=prompt,
        image_format="url",  # or "base64"
    )

    # The API may revise your prompt — useful to see what it actually rendered
    print(f"Revised prompt: {response.prompt}")
    print(f"Image URL: {response.url}")

    # Download and save
    img_data = requests.get(response.url).content
    with open(output_file, "wb") as f:
        f.write(img_data)

    print(f"Saved to {output_file}")
    return output_file


def generate_image_base64(prompt: str, output_file: str = "output_b64.png") -> str:
    """Same, but using base64 format — no second HTTP request needed."""
    response = client.image.sample(
        model="grok-2-image",
        prompt=prompt,
        image_format="base64",
    )

    with open(output_file, "wb") as f:
        f.write(base64.b64decode(response.image))

    print(f"Saved to {output_file}")
    return output_file


def generate_batch(prompt: str, n: int = 4) -> list[str]:
    """Generate multiple images from one prompt (up to 10)."""
    responses = client.image.sample_batch(
        model="grok-2-image",
        prompt=prompt,
        n=n,
        image_format="url",
    )

    files = []
    for i, resp in enumerate(responses):
        filename = f"batch_{i}.png"
        img_data = requests.get(resp.url).content
        with open(filename, "wb") as f:
            f.write(img_data)
        files.append(filename)
        print(f"Saved {filename}")

    return files


if __name__ == "__main__":
    generate_image(
        prompt="A futuristic data center with glowing blue server racks, digital art style",
        output_file="datacenter.png",
    )

