# Connect to Microsoft Graph with required permissions
Connect-MgGraph -Scopes "Group.Read.All", "User.Read.All"

# Define the group prefix
$groupPrefix = "Grok_"

# Fetch groups matching the prefix
$groups = Get-MgGroup -Filter "startswith(displayName, '$groupPrefix')" -All

if (-not $groups) {
    Write-Host "No groups found starting with '$groupPrefix'" -ForegroundColor Yellow
    return
}

# Array to store the combined results
$report = [System.Collections.Generic.List[PSCustomObject]]::new()

foreach ($group in $groups) {
    Write-Host "Processing group: $($group.DisplayName)" -ForegroundColor Cyan
    
    # Retrieve members for the group (filtered to only include Users)
    $members = Get-MgGroupMember -GroupId $group.Id -All | Where-Object { $_.AdditionalProperties['@odata.type'] -eq '#microsoft.graph.user' }
    
    foreach ($member in $members) {
        # Retrieve detailed user properties
        $user = Get-MgUser -UserId $member.Id -Property DisplayName, UserPrincipalName, Mail
        
        $report.Add([PSCustomObject]@{
            GroupName          = $group.DisplayName
            GroupId            = $group.Id
            UserDisplayName    = $user.DisplayName
            UserPrincipalName  = $user.UserPrincipalName
            UserEmail          = $user.Mail
        })
    }
}

# Display results in the console
$report | Format-Table -AutoSize

